enum error_code {
    success = 0;
    cannot_claimed = 1;
    cannot_completed = 2;
    not_enough_money = 3;
    no_this_equip = 4;
    no_this_item = 5;
}

enum em_direction {
    stationary = 0;
    up = 1;
    down = 2;
    left = 3;
    right = 4;
}

struct position {
    int32 x;
    int32 y;
}

enum em_equip_type {
    helmet = 1;     // 头盔
    jacket = 2;     // 上装
    trousers = 3;   // 裤子
    gloves = 4;     // 手套
    boots = 5;      // 靴子
    weapon = 6;     // 武器
    shooting = 7;   // 远程攻击武器
}

enum em_shooting_bullet {
    arrow = 1;
    bullet = 2;
}

struct equip_info {
    string id;
    string name;
    string icon;
    string desc;
    em_equip_type equip_type;
    int32 add_hp;
    int32 add_mp;
    int32 add_defense;
}

struct weapon_info {
    string id;
    string name;
    string icon;
    string desc;
    em_equip_type equip_type;
    int32 attack;
}

struct bullet_info {
    string id;
    string name;
    string icon;
    string desc;
    em_shooting_bullet type;
    int32 attack;
    int32 speed;
}

struct shooting_info {
    string id;
    string name;
    string icon;
    string desc;
    em_equip_type equip_type;
    bullet_info _bullet_info;
}

enum em_task_state {
    can_claimed = 1;
    in_progress = 2;
    can_completed = 3;
}

struct task_info {
    int32 task_id;
    int32 progress;
    em_task_state status;
}

struct item {
    string item_id;
    int32 item_type;
    int32 item_count;
}

enum em_harm_type {
    melee_attack = 1;
    bullet_damage = 2;
    bow_arrow = 3;
}