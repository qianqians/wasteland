enum error_code {
    success = 0;
    cannot_claimed = 1;
    cannot_completed = 2;
    not_enough_money = 3;
    no_this_equip = 4;
    no_this_item = 5;
    undefined_player_id = 6;
    unlock_talk_task = 7;
    unlock_level_not_completed = 8;
    unconfig_talk_task = 9;
    talk_npc_not_scene = 10;
    cannot_use_skill = 11;
    not_in_spawn_point = 12;
}

enum em_rarity {
  common = 1;     // 普通
  rare = 2;       // 稀有
  epic = 3;       // 史诗
  legendary = 4;  // 传说
  myth = 5;       // 神话
}

enum em_equip_type {
    helmet = 1;     // 头盔
    jacket = 2;     // 上装
    trousers = 3;   // 裤子
    gloves = 4;     // 手套
    boots = 5;      // 靴子
    weapon = 6;     // 武器

    bb_attack = 11;    // 宠物武器
    bb_defense = 12;   // 宠物防具 物理/魔法防御
    bb_resist = 13;    // 宠物抗性 封印/混乱 抗性
}

enum em_buff_type {
    em_seal_action = 1; //封印所有行为
    em_seal_skill = 2;  //封印使用技能
    
    em_confuse_attack_all = 4;    //混乱随机攻击场上成员
    em_confuse_attack_allies = 8; //混乱随机攻击本方成员

    em_heal_hp = 16; //恢复元气
    em_heal_mp = 32; //恢复真气

    em_damage_hp = 64; //伤害元气
    em_damage_mp = 128;//伤害真气

    em_defense_value = 256; //添加固定数值防御
    em_defense_ratio = 512; //添加防御数值系数
}

struct attribute {
    int32 hp;
    int32 mp;
    int32 max_hp;
    int32 max_mp;
    int32 attack;
    int32 defense;
    int32 tmp_defense;
    int32 matk;
    int32 resist;
}

struct equip_info {
    string equip_id;
    string name;
    string icon;
    string desc;
    em_equip_type equip_type;
    em_rarity rarity;
    attribute abonus;
}

enum direction {
	none = 0;
	up = 1;
	down = 2;
	left = 4;
	right = 8;
}

struct position {
    int32 x;
    int32 y;
    int32 x_speed;
    int32 y_speed;
    int32 dir;
}

enum skill_type {
    skill_change_abonus_attack = 1; //物理攻击 
    skill_change_abonus_magic = 2;  //魔法攻击
    skill_add_buffer = 3;
    skill_dispel_buffer = 4;
}

struct skill_info {
    int32 skill_id;
    skill_type _type;
    bool target_enemy;   
    float value0;
    float value1;
    float ratio;
    int32 range;
    int32 cast_mp;
    int32 cd_round;
}

struct gongfa_bonus {
    attribute abonus;
    skill_info[] skills;
}

struct gongfa {
    int32 gongfa_table_id;
    em_rarity rarity;
    int32 gongfa_level;
    gongfa_bonus abonus;
}

enum em_task_state {
    can_claimed = 1;
    in_progress = 2;
    can_completed = 3;
    completed = 4;
}

struct task_progress_info {
    int32 table_id;
    int32 total;
    int32 progress;
    int32[] watch_task;
}

struct task_info {
    int32 task_id;
    em_task_state status;
    task_progress_info[] progress;
    int64 refresh_time;
}

struct item {
    int32 item_type;
    int32 item_count;
}

struct bb {
    string entity_id;
    int32 bb_table_id;
    em_rarity rarity;
    int32 level;
    int32 speed;
    attribute abonus;
    skill_info[] skills;
    equip_info[] equips;     // 宠物穿戴的装备
}

enum em_role_gender {
    em_role_gender_female = 0;
    em_role_gender_male = 1;
}

struct player_info {
    string account_id;
    string player_id;
    string player_nick_name; // 玩家昵称
    string player_appearance; // 玩家外观
    attribute abonus;        // 玩家基础属性
    gongfa[] gfs;            // 玩家修炼过的功法
    gongfa curr_gf;          // 玩家当前使用的功法
    equip_info[] equips;     // 玩家穿戴的装备
    bb[] wait_bbs;                // 玩家携带的宠物
    bb[] curr_bbs;            // 当前出战宠物
    item[] items;            // 玩家背包 
    task_info[] tasks;       // 领取的任务
    em_role_gender gender;            // 玩家性别
	string scene;            // 玩家所在场景
    int32 line;              // 玩家所在世界线
	position pos;            // 玩家位置
}

struct battle_entity {
    string entity_id;
    string nick_name;
    string appearance;
    int32 speed;
    int32 level;
    bool is_live;
    attribute abonus;
    skill_info[] skills;
}

struct battle_info {
    battle_entity battle_team0; // 出战单位0
    battle_entity battle_team1; // 出战单位1
    bb curr_bbs0;               // 玩家携带的宠物0
    bb curr_bbs1;               // 玩家携带的宠物1
    battle_entity player;
    item[] items;                // 玩家背包 
	string scene;                // 玩家所在战斗场景
}