enum error_code {
    success = 0;
    cannot_claimed = 1;
    cannot_completed = 2;
    not_enough_money = 3;
    no_this_equip = 4;
    no_this_item = 5;
    undefined_player_id = 6;
}

enum em_direction {
    stationary = 0;
    up = 1;
    down = 2;
    left = 3;
    right = 4;
}

struct position {
    int32 x;
    int32 y;
}

enum em_equip_type {
    helmet = 1;     // 头盔
    jacket = 2;     // 上装
    trousers = 3;   // 裤子
    gloves = 4;     // 手套
    boots = 5;      // 靴子
    weapon = 6;     // 武器
    shooting = 7;   // 远程攻击武器
}

enum em_shooting_bullet {
    arrow = 1;
    bullet = 2;
}

struct equip_info {
    string id;
    string name;
    string icon;
    string desc;
    em_equip_type equip_type;
    int32 add_hp;
    int32 add_mp;
    int32 attack;
    int32 add_defense;
}

struct bullet_info {
    string id;
    string name;
    string icon;
    string desc;
    em_shooting_bullet type;
    int32 attack;
    int32 speed;
}

enum direction {
	none = 0;
	up = 1;
	down = 2;
	left = 3;
	right = 4;
}

struct player_info {
    string account_id;
    string player_id;
    string player_nick_name; // 玩家昵称
    int32 player_appearance; // 玩家外观
    int32 gender;    // 玩家性别
	int32 level;     // 玩家等级
    string scene;    // 玩家所在场景
    int32 line;      // 玩家所在世界线
	position pos;    // 玩家位置
    direction dir;   // 玩家朝向
}

enum em_task_state {
    can_claimed = 1;
    in_progress = 2;
    can_completed = 3;
    completed = 4;
}

struct task_progress_info {
    int32 id;
    int32 progress;
    int32 total;
}

struct task_info {
    int32 task_id;
    task_progress_info[] progress;
    em_task_state status;
    int64 refresh_time;
}

struct item {
    string item_id;
    int32 item_type;
    int32 item_count;
}

enum em_harm_type {
    melee_attack = 1;
    bullet_damage = 2;
    bow_arrow = 3;
}

struct skill_info {
    int32 skill_id;
    int32 skill_level;
    int32 cd_time;
}