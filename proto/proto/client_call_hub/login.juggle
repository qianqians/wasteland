import common

enum em_platform {
  EPlatformGoogle = 1;
  EPlatformIphone = 2;
  EPlatformSteam = 3;
}

entity_service login {
    create_character req(string player_nick_name, em_role_gender gender, em_player_appearance appearance, string scene) rsp(player_info player) err(int32 errCode);
    select_character req(string player_id) rsp(player_info player) err(int32 errCode);
}