import common

enum em_platform {
  EPlatformWX = 1;
  EPlatformTap = 2;
  EPlatformDy = 3;
}

entity_service login {
    get_character req(em_platform platform, string code) rsp(player_info[] player) err(int32 errCode);
    create_character req(string player_nick_name, int32 gender, string scene) rsp(player_info player) err(int32 errCode);
    select_character req(string player_id) rsp(player_info player) err(int32 errCode);
}